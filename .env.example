# Template only. Spring Boot does NOT load this file automatically.
# Set real values in the process environment or your secret manager, never in Git.
DB_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=5
SERVER_PORT=8083
SERVER_ADDRESS=127.0.0.1
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
KAFKA_CONSUMER_GROUP=bd-report-v1
KAFKA_EVENTS_TOPIC=bd.requests.events.v1
KAFKA_ANALYTICS_TOPIC=bd.requests.analytics.v1
KAFKA_CONCURRENCY=3
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_LISTENER_ENABLED=true
KAFKA_CONSUMER_RETRIES=2
KAFKA_RETRY_DELAY_MS=1000
OUTBOX_ENABLED=true
OUTBOX_DELAY_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_SEND_TIMEOUT_MS=20000
